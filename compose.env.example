############################################
# Etosema compose.env example (NO SECRETS)
#
# 1) Copy one of the env presets and edit values:
#    cp dev.compose.env compose.env
#    # or
#    cp prod.compose.env compose.env
#
# 2) Run:
#    docker compose up -d --build
#
# Or просто:
#    ./scripts/use-env.sh dev
#    ./scripts/use-env.sh prod
############################################

# ---------- App URLs ----------
NODE_ENV=development
APP_BIND_ADDR=127.0.0.1
POSTGRES_BIND_ADDR=127.0.0.1
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# ---------- Database ----------
DATABASE_URL=postgresql://etosema:etosema_password@postgres:5432/etosema_db?schema=public

# ---------- Admin ----------
ADMIN_EMAIL=admin@etosema.ru
ADMIN_PASSWORD=changeme

# ---------- Secrets (MUST be >= 32 chars) ----------
PIN_SESSION_SECRET=changeme_pin_session_secret_key_min_32_chars
JWT_SECRET=changeme_jwt_secret_key_minimum_32_characters
SESSION_SECRET=changeme_session_secret_key_minimum_32_char

# ---------- S3 ----------
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_URL=https://bucket.s3.example.com
S3_BUCKET=etosema
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
############################################
# Etosema Docker environment example
#
# Copy to ./compose.env (gitignored) and run:
#   docker compose up -d --build
#
# docker-compose.yml uses `env_file: ./compose.env` for backend/frontend.
############################################

# ---------- App URLs ----------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------- Database ----------
DATABASE_URL=postgresql://etosema:etosema_password@postgres:5432/etosema_db?schema=public

# ---------- Admin ----------
ADMIN_EMAIL=admin@etosema.ru
ADMIN_PASSWORD=changeme

# ---------- Secrets (dev defaults, MUST be >= 32 chars) ----------
PIN_SESSION_SECRET=changeme_pin_session_secret_key_min_32_chars
JWT_SECRET=changeme_jwt_secret_key_minimum_32_characters
SESSION_SECRET=changeme_session_secret_key_minimum_32_char

# ---------- S3 (ВАШ внешний S3) ----------
# Важно:
# - S3_ENDPOINT: endpoint вашего S3 (может быть https://s3.<provider>.tld)
# - S3_PUBLIC_URL: публичная база (чтобы браузер мог грузить файлы)
# - ключи/бакет/регион — ваши
S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_URL=https://public.example.com/etosema
S3_BUCKET=etosema
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

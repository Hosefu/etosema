# Backend-specific ignores
# (Common ignores are in root .gitignore)

# Prisma database files (backend-specific)
prisma/*.db
prisma/*.db-journal

# Backend uploads (keep folder structure)
public/uploads/*
!public/uploads/cases/
!public/uploads/medias/
public/uploads/cases/*
public/uploads/medias/*
!public/uploads/**/.gitkeep
